generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Flow {
  id        String   @id @default(cuid())
  name      String
  nodes     String   // JSON-encoded GraphNode[]
  edges     String   // JSON-encoded GraphEdge[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
